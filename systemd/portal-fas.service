[Unit]
Description=Portal FAS (openNDS Forwarding Authentication Service)
After=network.target mariadb.service freeradius.service
Requires=mariadb.service

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/portal/fas
EnvironmentFile=/etc/portal/fas.env
ExecStart=/opt/portal/venv/bin/gunicorn -w 2 -b 0.0.0.0:2080 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
