[Unit]
Description=Portal Admin Dashboard
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/portal/dashboard
EnvironmentFile=/etc/portal/dashboard.env
ExecStart=/opt/portal/venv/bin/gunicorn -w 2 -b 127.0.0.1:8090 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
